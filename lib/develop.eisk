#!/bin/bash

disableCors() {
  if [ $(getSystemOS) = "Mac" ]; then
    # Mac OS
    open -n -a /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --args --user-data-dir="/tmp/chrome_dev_test" --disable-web-security
  elif [ $(getSystemOS) = "Msys" ]; then
    # Windows
    cd ~/Documents
    "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe" --disable-web-security --disable-gpu --user-data-dir=~/chromeTemp
  else
    # Linux
    google-chrome --disable-web-security
  fi
}

hosts() {
  local FIND_HOSTS

  case "$OSTYPE" in
    msys*)
      FIND_HOSTS="/c/Windows/System32/drivers/etc"
    ;;
    *)
      FIND_HOSTS="/etc"
    ;;
  esac

  if [ -z $1 ]; then
    code "$FIND_HOSTS/hosts"
    return
  fi

  cp "$FIND_HOSTS/$1" "$FIND_HOSTS/hosts"
}

deleteFolders() {
  usageFolderDelete() {
    echo "Usage: deleteFolders <folder1> <folder2> ..."
    echo "Example: deleteFolders node_modules .cache"
  }

  recursiveDeleteFolders() {
    local base_dir="$1"
    local folder_name="$2"

    if [ ! -d "$base_dir" ]; then
      echo "Error: Directory '$base_dir' does not exist"
      return 1
    fi

    find "$base_dir" -depth -type d -name "$folder_name" -exec rm -rf {} \; 2>/dev/null

    echo "✓ Deleted all '$folder_name' folders"
  }

  if [ $# -eq 0 ]; then
    usageFolderDelete
    return 1
  fi

  for folder in "$@"; do
    recursiveDeleteFolders . "$folder"
  done
}
